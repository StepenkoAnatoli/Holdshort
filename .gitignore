# --- secrets / credentials (row-4 decision: keys live in a local .env, never in the repo) ---
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
secrets*.json

# --- pilot telemetry / generated artifacts ---
tools/pilot_ledger.jsonl
tools/*.ledger.jsonl
tools/live_fill_sheet.json
tools/live_fill_sheet.csv
# (live-fill artifacts are generated; generator + tally are tracked)
**/__pycache__/
*.pyc

# --- OS noise ---
Thumbs.db
.DS_Store
tools/task_state/

# --- tool byproducts created when HOME/XDG point inside the repo ---
# `.githooks/pre-commit` exports HOME="$REPO_ROOT", and tools that fall back to
# XDG paths (e.g. `gh`, which wrote .local/state/gh/device-id here on 2026-10-11)
# then drop machine-local state into the checkout. Byproduct, not evidence.
.local/
